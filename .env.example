##############################################################################
# AKRU — Accounting, Finance & Tax Control
# Environment Configuration
# Platform: AKRU OS
##############################################################################

APP_NAME=AKRU
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

##############################################################################
# Database — MySQL (Blueprint §11.1)
##############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=akru
DB_USERNAME=root
DB_PASSWORD=

##############################################################################
# Session & Cache
##############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

##############################################################################
# Mail
##############################################################################
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@akru.id"
MAIL_FROM_NAME="AKRU"

##############################################################################
# Redis (opsional — VPS upgrade path)
##############################################################################
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

##############################################################################
# AKRU — Application-specific Config
##############################################################################

# AI Add-on (Blueprint §1.8 — disabled by default = AKRU Standard)
AKRU_AI_ENABLED=true

# Developer / Application Owner AI Provider Configuration
# Dikelola khusus oleh pemilik aplikasi (Bukan klien per entitas)
AI_DEFAULT_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI ChatGPT API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Coretax-ready Export
AKRU_CORETAX_FORMAT_VERSION=2026.1

# Storage
AKRU_MAX_UPLOAD_SIZE_MB=10
AKRU_DOCUMENT_RETENTION_DAYS=2555

# PWA
VITE_APP_NAME="AKRU"
VITE_APP_DESCRIPTION="Data nyata. Kendali penuh."
